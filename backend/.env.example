# Override the SQLite database file location.
# Default: sqlite:///./var/timizer.db (relative to the backend/ directory).
TIMIZER_DATABASE_URL=sqlite:///./var/timizer.db

# Externally reachable base URL used when generating client-signature links.
# Must match the Vite/dev or production frontend origin (include port in local dev).
TIMIZER_PUBLIC_FRONTEND_BASE_URL=http://localhost:5173
