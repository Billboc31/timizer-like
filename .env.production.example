# SQLite database file location inside the container.
# The /app/var directory is mounted as a named Docker volume (timizer-db)
# so data survives restarts and image rebuilds.
TIMIZER_DATABASE_URL=sqlite:////app/var/timizer.db

# Absolute path to the provider signature image inside the container.
# The /app/assets directory is mounted as a named Docker volume (timizer-assets).
# Copy the signature file into that volume before the first deploy:
#   docker compose -f docker-compose.prod.yml run --rm backend \
#     cp /host/path/to/provider-signature.png /app/assets/provider-signature.png
# Supported formats: .png, .jpg, .jpeg
TIMIZER_PROVIDER_SIGNATURE_PATH=/app/assets/provider-signature.png
