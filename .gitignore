backend/var/*.db
backend/var/*.db-journal

backend/.env

# Maven build output — must never be committed (causes artificial merge conflicts).
backend/target/

# Frontend dependencies and build output — already listed in frontend/.gitignore
# but previously tracked files must stay ignored at the root too.
frontend/node_modules/
frontend/dist/

# Production environment — contains secrets, never committed.
.env.production

# Provider signature asset — never committed. See docs/provider-signature.md.
assets/provider-signature.png
assets/provider-signature.jpg
assets/provider-signature.jpeg
